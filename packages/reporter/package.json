{
  "name": "@eyesonbug/reporter",
  "version": "0.1.0",
  "license": "UNLICENSED",
  "description": "Send acceptance test results to EyesOnBug from CI",
  "type": "commonjs",
  "bin": {
    "eyesonbug": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./playwright": {
      "types": "./dist/playwright-reporter.d.ts",
      "import": "./dist/playwright-reporter.mjs",
      "require": "./dist/playwright-reporter.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@eyesonbug/adapters": "workspace:*",
    "@eyesonbug/shared": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "tsup": "^8.3.5",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8",
    "@playwright/test": "^1.49.1"
  },
  "peerDependencies": {
    "@playwright/test": ">=1.40.0"
  },
  "peerDependenciesMeta": {
    "@playwright/test": {
      "optional": true
    }
  }
}
