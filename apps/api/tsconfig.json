{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // Node16 resolution so package `exports` maps work (the shared
    // package publishes a node-only subpath). Emits CommonJS, which is what
    // Nest's decorator metadata needs.
    "module": "Node16",
    "moduleResolution": "Node16",
    // No rootDir here: this config typechecks `test` as well as `src`.
    // The emitting config (tsconfig.build.json) sets it.
    "outDir": "dist",
    "noEmit": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "strictPropertyInitialization": false,
    "isolatedModules": false
  },
  "include": ["src", "test"]
}
