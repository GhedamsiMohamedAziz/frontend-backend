# ─── Database ───────────────────────────────────────────────────────────────
# App role: RLS applies. This is what the API and worker use.
DATABASE_URL=postgres://eyesonbug_app:eyesonbug_app@localhost:5432/eyesonbug
# Owner role: bypasses RLS. Migrations and the seed script only.
DATABASE_MIGRATION_URL=postgres://eyesonbug:eyesonbug@localhost:5432/eyesonbug

# ─── Redis ──────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── Artifact storage (MinIO locally, any S3 in production) ─────────────────
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=eyesonbug-artifacts
S3_ACCESS_KEY_ID=eyesonbug
S3_SECRET_ACCESS_KEY=eyesonbug-dev-secret
S3_FORCE_PATH_STYLE=true

# ─── Auth ───────────────────────────────────────────────────────────────────
# openssl rand -hex 32
SESSION_SECRET=replace-me-with-32-bytes-of-hex-0000000000000000000000000000
SESSION_COOKIE_NAME=eob_session
SESSION_TTL_HOURS=720

# GitHub OAuth app (login). Callback: http://localhost:4000/v1/auth/github/callback
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=

# ─── URLs ───────────────────────────────────────────────────────────────────
API_URL=http://localhost:4000
WEB_URL=http://localhost:3000
PORT=4000

# ─── Runtime ────────────────────────────────────────────────────────────────
NODE_ENV=development
LOG_LEVEL=debug

# Dev-only escape hatch: lets `POST /v1/auth/dev-login` mint a session without
# GitHub, so the seeded demo data is usable before OAuth is configured.
# Ignored unless NODE_ENV=development.
ALLOW_DEV_LOGIN=true
